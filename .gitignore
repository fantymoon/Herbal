node_modules
dist
.DS_Store
.env

# Rendered masters stay out of Git (173 MB of mp4). They are NOT backed up by this
# repo, so keep a copy elsewhere: `npm run manifest` writes masters-manifest.json,
# which records which masters existed and their sizes so a loss is detectable.
out

# Per-segment TTS transcripts for the long-form series. Regenerable from the voice
# modules via `npm run topic:build`, and rewritten on every run.
remotion-video/.topic-work

# Same for the 「本草一问」 series: per-segment text, word-level boundary JSON and the
# synthesis job file. Regenerable via `npm run ask:voice`, rewritten on every run.
# The audio itself (public/voice/<id>/) IS committed — it is the film's time base.
remotion-video/.ask-work

# 长视频联络表等中间产物（npm run longform:sheet）——一张 PNG，重跑就有。
remotion-video/.longform-work

# Agent scratch: extracted frames, TTS probes, one-off scripts. Neither product nor
# evidence, and small enough that nobody will remember to delete them.
.workbuddy-ai/tmp/
# Regenerable synthesis transcripts, same class as .topic-work / .ask-work.
remotion-video/.voice-work
remotion-video/.topic-work-en

# 第三方语料，下载来考察过，**没有任何代码读它们**：合计约 7.7 GB / 3.2 万文件。
# 不入库是体积原因，不是价值判断。产品语料只有 TCM-Ancient-Books-master/ 一处
# （它入库，progress.json 与每一句 今译 都从它派生）；要引用这里某一部书之前，
# 先把那部书挪进产品语料那条通道，而不是就地按路径读。
chinese-poetry-master/
daizhigev20-master/
古籍藏书(12亿汉字)/
